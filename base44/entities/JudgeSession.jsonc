      "type": "string",
      "enum": [
        "match",
        "round"
      ]
    },
    "info": {
      "type": "object",
      "additionalProperties": true
    },
    "results": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at_ms": {
      "type": "number"
    },
    "updated_at_ms": {
      "type": "number"
    }
  },
  "required": [
